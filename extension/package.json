{
  "name": "decap",
  "displayName": "decap",
  "description": "Captures a before and after image when a commit changes an old line.",
  "version": "0.1.4",
  "publisher": "quarkos",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuarkOS/decap.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "decisions",
    "snapshot"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "decap.snap",
        "title": "decap: Snap"
      },
      {
        "command": "decap.openDecisions",
        "title": "decap: Open decisions"
      },
      {
        "command": "decap.showLog",
        "title": "decap: Show log"
      },
      {
        "command": "decap.fillWhy",
        "title": "decap: Fill in why"
      },
      {
        "command": "decap.reviewLast",
        "title": "decap: Review last commit"
      }
    ],
    "keybindings": [
      {
        "command": "decap.snap",
        "key": "alt+shift+s",
        "mac": "alt+shift+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decap",
          "title": "decap",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "**/.decisions/*/note.md": "default"
      }
    },
    "views": {
      "decap": [
        {
          "type": "webview",
          "id": "decap.decisions",
          "name": "Decisions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "npm run compile && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js --format=cjs && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "mocha": "^10.7.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "pureimage": "^0.4.20"
  }
}
